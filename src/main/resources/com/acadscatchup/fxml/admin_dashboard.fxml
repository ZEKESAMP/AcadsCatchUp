<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acadscatchup.controller.AdminDashboardController"
            styleClass="root-pane"
            stylesheets="@../css/style.css">

    <!-- ── TOP BAR ── -->
    <top>
        <HBox fx:id="topBar" styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <!-- Left Branding Cluster -->
            <HBox alignment="CENTER_LEFT" spacing="10" minWidth="-Infinity">
                <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                    <image>
                        <Image url="@../img/book_icon_blue.png" />
                    </image>
                </ImageView>
                <Label fx:id="appTitleLabel" text="AcadsCatchUp" styleClass="app-title" minWidth="-Infinity" />
                <Label fx:id="roleBadge" text="Admin Dashboard" styleClass="dash-role-admin" minWidth="-Infinity" />
                <Label fx:id="syncStatusLabel" text="🟢 Live Sync" styleClass="sync-badge" minWidth="-Infinity" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" minWidth="8" />

            <!-- Right Controls Cluster -->
            <HBox alignment="CENTER_RIGHT" spacing="8" minWidth="-Infinity">
                <Button fx:id="adminInboxBtn" text="📥 Bug Reports (0)" styleClass="btn-ghost" onAction="#handleOpenBugReports" minWidth="-Infinity" />
                <Button fx:id="smtpConfigBtn" text="📧 SMTP Config" styleClass="btn-ghost" onAction="#handleOpenSmtpConfig" minWidth="-Infinity" />
                <Button fx:id="settingsBtn" text="⚙ Settings" styleClass="btn-ghost" onAction="#handleOpenAccountSettings" minWidth="-Infinity" />
                <Label fx:id="adminNameLabel" styleClass="user-name-label" maxWidth="175" minWidth="50" />
                <Button text="Logout" styleClass="btn-outline-sm" id="adminLogoutBtn" fx:id="adminLogoutBtn" onAction="#handleLogout" minWidth="-Infinity" />
            </HBox>
        </HBox>
    </top>

    <!-- ── LEFT SIDEBAR ── -->
    <left>
        <VBox styleClass="sidebar" spacing="12" minWidth="230">
            <Label text="USER DIRECTORY" styleClass="sidebar-section-title" />
            <VBox spacing="4">
                <Label text="Filter by Role" styleClass="filter-label" />
                <ComboBox fx:id="roleFilterCombo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="4">
                <Label text="Filter by Program" styleClass="filter-label" />
                <ComboBox fx:id="programFilterCombo" maxWidth="Infinity" />
            </VBox>
            <VBox spacing="4">
                <Label text="Filter by Year" styleClass="filter-label" />
                <ComboBox fx:id="yearFilterCombo" maxWidth="Infinity" />
            </VBox>

            <Separator />
            <Label text="ACADEMIC CONTROLS" styleClass="sidebar-section-title" />
            <Button fx:id="btnAddUserSidebar" text="＋ Add New User" styleClass="btn-primary" maxWidth="Infinity" onAction="#handleAddUser" />
            <Button fx:id="btnEnrollSidebar" text="🎓 Enroll Students" styleClass="btn-secondary" maxWidth="Infinity" onAction="#handleEnrollStudent" />
            <Button fx:id="btnManageSubjectsSidebar" text="📚 Manage Subjects" styleClass="btn-secondary" maxWidth="Infinity" onAction="#handleManageSubjects" />

            <Separator />
            <Label text="SYSTEM TOOLS" styleClass="sidebar-section-title" />
            <Button text="📥 View Bug Reports" styleClass="btn-ghost" maxWidth="Infinity" onAction="#handleOpenBugReports" />
            <Button text="📧 SMTP &amp; 2FA Setup" styleClass="btn-ghost" maxWidth="Infinity" onAction="#handleOpenSmtpConfig" />
            <Button text="↺ Reset Filters" styleClass="btn-ghost" maxWidth="Infinity" onAction="#handleResetFilters" />

            <Region VBox.vgrow="ALWAYS" />
            <VBox spacing="4" style="-fx-background-color: rgba(30, 34, 56, 0.6); -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #2d3255; -fx-border-radius: 8;">
                <Label text="SYSTEM STATUS" style="-fx-text-fill: #94a3b8; -fx-font-size: 10px; -fx-font-weight: bold;" />
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="●" style="-fx-text-fill: #10b981; -fx-font-size: 12px;" />
                    <Label text="Database Online" style="-fx-text-fill: #e2e8f0; -fx-font-size: 11px;" />
                </HBox>
                <Label text="AcadsCatchUp v1.0 • F4TAL" style="-fx-text-fill: #64748b; -fx-font-size: 10px;" />
            </VBox>
        </VBox>
    </left>

    <!-- ── CENTER CONTENT ── -->
    <center>
        <ScrollPane fx:id="dashboardScrollPane" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="dashboard-scroll">
            <VBox spacing="14" styleClass="content-area">

                <!-- Stats Row -->
                <HBox fx:id="statsRow" styleClass="stats-row" spacing="16">
                    <VBox fx:id="statTotalUsers" styleClass="stat-card stat-total" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="totalUsersCount" text="0" styleClass="stat-number" />
                        <Label text="Total Users" styleClass="stat-label" />
                    </VBox>
                    <VBox fx:id="statStudents" styleClass="stat-card stat-pending" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="studentsCount" text="0" styleClass="stat-number" />
                        <Label text="Students" styleClass="stat-label" />
                    </VBox>
                    <VBox fx:id="statProfessors" styleClass="stat-card stat-submitted" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="professorsCount" text="0" styleClass="stat-number" />
                        <Label text="Professors" styleClass="stat-label" />
                    </VBox>
                    <VBox fx:id="statSubjects" styleClass="stat-card stat-graded" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="subjectsCount" text="0" styleClass="stat-number" />
                        <Label text="Subjects" styleClass="stat-label" />
                    </VBox>
                    <VBox fx:id="statReports" styleClass="stat-card stat-admin" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="openReportsCount" text="0" styleClass="stat-number" style="-fx-text-fill: #c084fc;" />
                        <Label text="Open Reports" styleClass="stat-label" />
                    </VBox>
                </HBox>

                <!-- Action Bar -->
                <FlowPane hgap="8" vgap="8" alignment="CENTER_LEFT" styleClass="action-bar-flow">
                    <Label text="User Accounts" styleClass="section-title" minWidth="-Infinity" />
                    <TextField fx:id="searchField" promptText="🔍  Search users..." styleClass="search-box" prefWidth="220" minWidth="140" onKeyReleased="#handleSearchKey" />
                    <Region prefWidth="8" />
                    <Button text="+ Add User" styleClass="btn-primary" id="adminAddUserBtn" onAction="#handleAddUser" minWidth="-Infinity" />
                    <Button text="✏ Edit" styleClass="btn-secondary" id="adminEditUserBtn" onAction="#handleEditUser" minWidth="-Infinity" />
                    <Button text="🗑 Delete" styleClass="btn-danger" id="adminDeleteUserBtn" onAction="#handleDeleteUser" minWidth="-Infinity" />
                    <Separator orientation="VERTICAL" />
                    <Button text="🎓 Enroll" styleClass="btn-secondary" onAction="#handleEnrollStudent" minWidth="-Infinity" />
                    <Button text="📚 Add Subject" styleClass="btn-secondary" onAction="#handleAddSubject" minWidth="-Infinity" />
                    <Separator orientation="VERTICAL" />
                    <Button text="📄 Export CSV" styleClass="btn-ghost" onAction="#handleExportCsv" minWidth="-Infinity" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="selectionCountLabel" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" />
                </FlowPane>

                <!-- Users Table -->
                <TableView fx:id="usersTable" VBox.vgrow="ALWAYS" minHeight="300" prefHeight="450" styleClass="items-table" id="adminUsersTable">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colSelect" prefWidth="36" minWidth="36" maxWidth="40" resizable="false" sortable="false" />
                        <TableColumn fx:id="colRole" text="Role" prefWidth="105" minWidth="80" />
                        <TableColumn fx:id="colUsername" text="Username" prefWidth="130" minWidth="90" />
                        <TableColumn fx:id="colFullName" text="Full Name" prefWidth="180" minWidth="120" />
                        <TableColumn fx:id="colEmail" text="Gmail Address" prefWidth="200" minWidth="140" />
                        <TableColumn fx:id="colProgram" text="Program / Subjects" prefWidth="160" minWidth="100" />
                        <TableColumn fx:id="colYear" text="Year Level" prefWidth="95" minWidth="70" />
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="110" minWidth="90" sortable="false" />
                    </columns>
                    <placeholder>
                        <Label text="No accounts match the current filter." styleClass="table-placeholder" />
                    </placeholder>
                </TableView>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
