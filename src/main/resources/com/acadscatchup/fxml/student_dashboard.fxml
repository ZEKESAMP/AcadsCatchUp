<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.acadscatchup.controller.StudentDashboardController"
            styleClass="root-pane"
            stylesheets="@../css/style.css">

    <!-- ── TOP BAR ── -->
    <top>
        <HBox fx:id="topBar" styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <!-- Left Branding Cluster: Guaranteed minWidth, never squishes or truncates -->
            <HBox alignment="CENTER_LEFT" spacing="10" minWidth="-Infinity">
                <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                    <image>
                        <Image url="@../img/book_icon_blue.png" />
                    </image>
                </ImageView>
                <Label fx:id="appTitleLabel" text="AcadsCatchUp" styleClass="app-title" minWidth="-Infinity" />
                <Label fx:id="roleBadge" text="Student View" styleClass="dash-role-label-student" minWidth="-Infinity" />
                <Label fx:id="syncStatusLabel" text="🟢 Live Sync" styleClass="sync-badge" minWidth="-Infinity" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" minWidth="8" />

            <!-- Right Controls Cluster: Cleanly grouped, user name truncated, logout always visible -->
            <HBox alignment="CENTER_RIGHT" spacing="10" minWidth="-Infinity">
                <Button fx:id="inboxBtn" text="📬 Inbox (0)" styleClass="btn-submitted" onAction="#handleOpenInbox" minWidth="-Infinity" />
                <Button fx:id="helpBtn" text="💬 Help / Bug Report" styleClass="btn-ghost" onAction="#handleOpenHelpReport" minWidth="-Infinity" />
                <Button fx:id="settingsBtn" text="⚙ Settings" styleClass="btn-ghost" onAction="#handleOpenAccountSettings" minWidth="-Infinity" />
                <Label fx:id="studentNameLabel" styleClass="user-name-label" maxWidth="175" minWidth="50" />
                <Button text="Logout" styleClass="btn-outline-sm" id="studentLogoutBtn" fx:id="studentLogoutBtn" onAction="#handleLogout" minWidth="-Infinity" />
            </HBox>
        </HBox>
    </top>

    <!-- ── CENTER ── -->
    <center>
        <ScrollPane fx:id="dashboardScrollPane" fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="dashboard-scroll">
            <VBox spacing="14" styleClass="content-area">

                <!-- Stats Cards -->
                <HBox fx:id="statsRow" styleClass="stats-row" spacing="16">
                    <VBox styleClass="stat-card stat-total"     HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="totalCount"     text="0" styleClass="stat-number" />
                        <Label text="Total"     styleClass="stat-label" />
                    </VBox>
                    <VBox styleClass="stat-card stat-pending"   HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="pendingCount"   text="0" styleClass="stat-number" />
                        <Label text="Pending"   styleClass="stat-label" />
                    </VBox>
                    <VBox styleClass="stat-card stat-submitted" HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="submittedCount" text="0" styleClass="stat-number" />
                        <Label text="Submitted" styleClass="stat-label" />
                    </VBox>
                    <VBox styleClass="stat-card stat-graded"    HBox.hgrow="ALWAYS" alignment="CENTER">
                        <Label fx:id="gradedCount"    text="0" styleClass="stat-number" />
                        <Label text="Graded"    styleClass="stat-label" />
                    </VBox>
                </HBox>

                <!-- Enrolled Subjects Section -->
                <VBox styleClass="enrolled-section" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="📚 Enrolled Subjects" styleClass="section-title-sm" />
                        <Label fx:id="enrolledCountBadge" text="0 Enrolled" styleClass="badge-enrolled-count" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="ℹ️ Enrolled subjects overview" styleClass="enrolled-hint" />
                    </HBox>
                    <FlowPane fx:id="enrolledSubjectsBox" hgap="10" vgap="8" styleClass="enrolled-flow-box">
                        <!-- Populated dynamically with subject cards -->
                    </FlowPane>
                </VBox>

                <!-- Filter + Action Bar (Auto-arranging FlowPane) -->
                <FlowPane hgap="10" vgap="8" alignment="CENTER_LEFT" styleClass="action-bar-flow">
                    <Label text="My Missed Items" styleClass="section-title" minWidth="-Infinity" />
                    <Region prefWidth="10" />
                    <Label text="Status:" styleClass="filter-label-inline" />
                    <ComboBox fx:id="statusFilterCombo" id="studentStatusFilter" />
                    <Label text="Subject:" styleClass="filter-label-inline" />
                    <ComboBox fx:id="subjectFilterCombo" id="studentSubjectFilter" />
                    <Button text="Apply" styleClass="btn-secondary" onAction="#applyFilters" />
                    <Button text="Clear" styleClass="btn-ghost" onAction="#clearFilters" />
                    <Separator orientation="VERTICAL" />
                    <Button fx:id="markSubmittedBtn" text="📤 Submit to Professor"
                            styleClass="btn-primary" id="studentMarkSubmittedBtn"
                            minWidth="-Infinity"
                            onAction="#handleMarkSubmitted" />
                </FlowPane>

                <!-- Table with full responsive width auto-sizing -->
                <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS" minHeight="280" prefHeight="400" styleClass="items-table" id="studentItemsTable">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="colSubject"    text="Subject"     prefWidth="140" minWidth="65" />
                        <TableColumn fx:id="colProfName"   text="Prof Name"   prefWidth="130" minWidth="60" />
                        <TableColumn fx:id="colType"       text="Type"        prefWidth="80"  minWidth="45" />
                        <TableColumn fx:id="colItemName"   text="Item Name"   prefWidth="180" minWidth="75" />
                        <TableColumn fx:id="colDateMissed" text="Date Missed" prefWidth="95"  minWidth="55" />
                        <TableColumn fx:id="colDeadline"   text="Deadline"    prefWidth="95"  minWidth="55" />
                        <TableColumn fx:id="colStatus"     text="Status"      prefWidth="85"  minWidth="50" />
                        <TableColumn fx:id="colNotes"      text="Notes"       prefWidth="160" minWidth="60" />
                    </columns>
                    <placeholder>
                        <Label text="You have no missed items! Great job 🎉" styleClass="table-placeholder" />
                    </placeholder>
                </TableView>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
