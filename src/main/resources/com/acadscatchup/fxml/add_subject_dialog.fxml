<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.acadscatchup.controller.AddSubjectController"
      styleClass="root-pane"
      stylesheets="@../css/style.css"
      style="-fx-border-color: #2d3255; -fx-border-width: 1.5; -fx-background-color: #0f1117;"
      prefWidth="480" spacing="0">

    <!-- Header (FAQ style) -->
    <HBox fx:id="headerBar" alignment="CENTER_LEFT" spacing="12" styleClass="dialog-header" style="-fx-cursor: move; -fx-padding: 14 18;">
        <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
            <image>
                <Image url="@../img/book_icon_blue.png" />
            </image>
        </ImageView>
        <VBox spacing="2">
            <Label text="Add New Subject — Admin Only" styleClass="dialog-title" style="-fx-font-size: 14px;" />
            <Label text="AcadsCatchUp • Subject Configuration" style="-fx-font-size: 10.5px; -fx-text-fill: #94a3b8;" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Body Form -->
    <VBox spacing="14" style="-fx-padding: 20 24 16 24;">
        <VBox spacing="6">
            <Label text="SUBJECT CODE" styleClass="form-label" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
            <TextField fx:id="codeField" promptText="e.g. CS201 or IT102" styleClass="text-field" style="-fx-font-size: 13px;" />
        </VBox>

        <VBox spacing="6">
            <Label text="SUBJECT NAME" styleClass="form-label" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #94a3b8;" />
            <TextField fx:id="nameField" promptText="e.g. Data Structures and Algorithms" styleClass="text-field" style="-fx-font-size: 13px;" onAction="#handleSave" />
        </VBox>

        <Label fx:id="errorLabel" style="-fx-text-fill: #f87171; -fx-font-size: 11.5px; -fx-font-weight: bold;" wrapText="true" />
    </VBox>

    <!-- Footer Action Bar -->
    <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-background-color: #151825; -fx-padding: 14 20; -fx-border-color: #2d3255; -fx-border-width: 1 0 0 0;">
        <Button text="Cancel" styleClass="btn-ghost" minWidth="-Infinity" onAction="#handleCancel" />
        <Button text="+ Add Subject" styleClass="btn-primary" minWidth="-Infinity" onAction="#handleSave" />
    </HBox>
</VBox>
