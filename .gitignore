# Compiled class files
*.class

# Maven build artifacts (preserve offline-first dependency cache and manifest)
target/*
!target/libs/
!target/MANIFEST.MF

# Log files
*.log

# IDE specific files
.idea/
*.iml
.vscode/*
!.vscode/settings.json
.settings/
.project
.classpath

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Build artifacts & distributions (prevent binary bloat and GitHub file limits)
dist/*.exe
dist/*.zip
dist/*.tar.gz
dist/*.jar
dist/*.tmp
dist/AcadsCatchUp/
dist/AcadsCatchUp-Portable/
dist/AcadsCatchUp-Linux/*.jar
dist/AcadsCatchUp-Linux/*.zip
dist/AcadsCatchUp-Linux/*.tar.gz
dist/jfx-mods/
dist/libs/

# SQLite local database
acadscatchup.db
